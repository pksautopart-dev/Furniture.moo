function calcDeal(deal) {
  const { originalPrice, qtyPaid, qtyReceived, discountPct, fixedDiscount, size } = deal;
  if (!originalPrice || originalPrice <= 0 || !qtyPaid || !qtyReceived) return null;

  const priceAfterFixed = Math.max(0, originalPrice - (fixedDiscount || 0));
  const priceAfterPct = priceAfterFixed * (1 - (discountPct || 0) / 100);
  const totalPaid = priceAfterPct * qtyPaid;
  const totalReceived = qtyReceived;
  const effectivePricePerUnit = totalPaid / totalReceived;
  const originalTotalValue = originalPrice * qtyReceived;
  const savings = originalTotalValue - totalPaid;
  const effectiveDiscountPct = (savings / originalTotalValue) * 100;
  const pricePerSize = size && size > 0 ? effectivePricePerUnit / size : null;

  return {
    totalPaid,
    totalReceived,
    effectivePricePerUnit,
    effectiveDiscountPct,
    savings,
    pricePerSize,
  };
}

function getBadges(deals, results) {
  const valid = results.map((r, i) => ({ r, i })).filter(({ r }) => r !== null);
  if (valid.length < 2) return results.map(() => []);

  const badges = results.map(() => []);

  // Best value (lowest effective price per unit)
  const bestUnit = valid.reduce((a, b) => (a.r.effectivePricePerUnit < b.r.effectivePricePerUnit ? a : b));
  badges[bestUnit.i].push({ label: "Best Value", color: "bg-emerald-500" });

  // Highest savings
  const highestSavings = valid.reduce((a, b) => (a.r.savings > b.r.savings ? a : b));
  if (highestSavings.i !== bestUnit.i) {
    badges[highestSavings.i].push({ label: "Highest Savings", color: "bg-blue-500" });
  }

  // Lowest unit price (pricePerSize)
  const hasSizeComparison = valid.every(({ r }) => r.pricePerSize !== null);
  if (hasSizeComparison) {
    const lowestPerSize = valid.reduce((a, b) => (a.r.pricePerSize < b.r.pricePerSize ? a : b));
    if (!badges[lowestPerSize.i].some(b => b.label === "Best Value")) {
      badges[lowestPerSize.i].push({ label: "Lowest Unit Price", color: "bg-violet-500" });
    }
  }

  // Winner badge (overall best)
  badges[bestUnit.i].push({ label: "🏆 Winner", color: "bg-yellow-500 text-yellow-900" });

  return badges;
}

function SmartRecommendation({ deals, results, currency }) {
  const valid = results.map((r, i) => ({ r, i, deal: deals[i] })).filter(({ r }) => r !== null);
  if (valid.length < 2) return null;

  const best = valid.reduce((a, b) => (a.r.effectivePricePerUnit < b.r.effectivePricePerUnit ? a : b));
  const worst = valid.reduce((a, b) => (a.r.effectivePricePerUnit > b.r.effectivePricePerUnit ? a : b));

  if (best.i === worst.i) return null;

  const pctBetter = ((worst.r.effectivePricePerUnit - best.r.effectivePricePerUnit) / worst.r.effectivePricePerUnit * 100).toFixed(1);
  const savingsDiff = (worst.r.effectivePricePerUnit - best.r.effectivePricePerUnit).toFixed(2);
  const bestName = best.deal.name || `Deal ${best.i + 1}`;
  const worstName = worst.deal.name || `Deal ${worst.i + 1}`;

  return (
    <div className="recommendation-card">
      <div className="rec-icon">🧠</div>
      <div className="rec-content">
        <div className="rec-title">Smart Recommendation</div>
        <div className="rec-text">
          <strong>{bestName}</strong> is the best choice — you pay{" "}
          <span className="rec-highlight">{pctBetter}% less per unit</span> compared to{" "}
          <strong>{worstName}</strong>, saving{" "}
          <span className="rec-highlight">{currency.symbol}{savingsDiff}</span> per unit received.
        </div>
        {valid.length > 2 && (
          <div className="rec-sub">
            Compared {valid.length} deals · Ranked by effective price per unit
          </div>
        )}
      </div>
    </div>
  );
}

function ComparisonBar({ deals, results, currency }) {
  const valid = results.map((r, i) => ({ r, i })).filter(({ r }) => r !== null);
  if (valid.length < 2) return null;

  const maxPrice = Math.max(...valid.map(({ r }) => r.effectivePricePerUnit));
  const minPrice = Math.min(...valid.map(({ r }) => r.effectivePricePerUnit));

  return (
    <div className="comparison-section">
      <div className="section-title">Price Comparison</div>
      {deals.map((deal, i) => {
        const r = results[i];
        if (!r) return null;
        const pct = maxPrice > 0 ? (r.effectivePricePerUnit / maxPrice) * 100 : 100;
        const isMin = r.effectivePricePerUnit === minPrice;
        const color = DEAL_COLORS[i % DEAL_COLORS.length];
        return (
          <div key={deal.id} className="bar-row">
            <div className="bar-label">{deal.name || `Deal ${i + 1}`}</div>
            <div className="bar-track">
              <div
                className={`bar-fill bg-gradient-to-r ${color.bg}`}
                style={{ width: `${pct}%` }}
              />
            </div>
            <div className={`bar-price ${isMin ? "bar-price-best" : ""}`}>
              {currency.symbol}{r.effectivePricePerUnit.toFixed(2)}
            </div>
          </div>
        );
      })}
    </div>
  );
}

